# Copy this file to .binary-load-lifter-ota.env. The local file is ignored by Git.
# Use the same token configured as API_TOKEN in include/secrets.h.
BINARY_LOAD_LIFTER_API_TOKEN=REPLACE_WITH_THE_SAME_LONG_RANDOM_TOKEN

# Optional. The default is binary-load-lifter.local. A reserved IPv4 address also works.
BINARY_LOAD_LIFTER_HOST=binary-load-lifter.local
